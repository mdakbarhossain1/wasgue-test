10\/Earth-Care.png","medium-width":42,"medium-height":90,"medium_large":"https:\/\/wasgeurtje.nl\/wp-content\/uploads\/2023\/10\/Earth-Care.png","medium_large-width":42,"medium_large-height":90,"large":"https:\/\/wasgeurtje.nl\/wp-content\/uploads\/2023\/10\/Earth-Care.png","large-width":42,"large-height":90,"1536x1536":"https:\/\/wasgeurtje.nl\/wp-content\/uploads\/2023\/10\/Earth-Care.png","1536x1536-width":42,"1536x1536-height":90,"2048x2048":"https:\/\/wasgeurtje.nl\/wp-content\/uploads\/2023\/10\/Earth-Care.png","2048x2048-width":42,"2048x2048-height":90,"cfw_cart_thumb":"https:\/\/wasgeurtje.nl\/wp-content\/uploads\/2023\/10\/Earth-Care.png","cfw_cart_thumb-width":42,"cfw_cart_thumb-height":90,"woocommerce_thumbnail":"https:\/\/wasgeurtje.nl\/wp-content\/uploads\/2023\/10\/Earth-Care.png","woocommerce_thumbnail-width":42,"woocommerce_thumbnail-height":90,"woocommerce_single":"https:\/\/wasgeurtje.nl\/wp-content\/uploads\/2023\/10\/Earth-Care.png","woocommerce_single-width":42,"woocommerce_single-height":90,"woocommerce_gallery_thumbnail":"https:\/\/wasgeurtje.nl\/wp-content\/uploads\/2023\/10\/Earth-Care.png","woocommerce_gallery_thumbnail-width":42,"woocommerce_gallery_thumbnail-height":90,"wc_order_status_icon":"https:\/\/wasgeurtje.nl\/wp-content\/uploads\/2023\/10\/Earth-Care.png","wc_order_status_icon-width":15,"wc_order_status_icon-height":32}},"text_1":"Milieuvriendelijke en ","text_2":"muurzame materialen"}],"checkboxtitle":"Waarom Full Moon zo speciaal is","items":[{"item":"Gaat tot 40+ wasbeurten mee "},{"item":" Delicaat floral aroma  "},{"item":"Langdurige geur"}],"details":[{"title":"Informatie over allergenen in onze producten","content":"Als onderdeel van onze toewijding aan transparantie en het verstrekken van informatie aan onze klanten, willen we u op de hoogte stellen van mogelijke allergenen in onze producten. We raden klanten met allergie\u00ebn aan om de onderstaande informatie zorgvuldig door te nemen. Houd er rekening mee dat deze informatie kan vari\u00ebren afhankelijk van het specifieke product. Neem bij twijfel altijd contact met ons op voor meer details"},{"title":"Voorzichtigheid Geboden","content":"Hanteren van wasparfum vereist aandacht. Hoewel het product veilig is bij correct gebruik, kan het bijtende eigenschappen hebben als het op onbedoelde oppervlakken komt door de pH-zuren. Giet het zorgvuldig in het wasverzachterbakje van uw wasmachine. Mocht u toch knoeien, maak het dan direct schoon om uw oppervlakken te beschermen."},{"title":"Allergie\u00ebn","content":"Let op: Vermijd contact met de ogen. In geval van contact, spoel grondig met water. Buiten bereik van kinderen houden. Niet inslikken. Bij inslikken onmiddellijk een arts raadplegen.\r\nBevat: ethylcinnamaat, linalool, limoneen, citronellol, 2-(4-tert-butylbenzyl)propionaldehyde, benzylsalicylaat, 2,4-dimethyl-3-cyclohexene-1-carboxaldehyde, octahydrocyclododecannone, 1-(2,6,6-trimethyl-3-cyclohexen-1-yl)-2-buten-1-one. Kan allergische reacties veroorzaken. Bevat (verordening 648\/2004): >50% parfum, amylcinnamal, benzylsalicylaat, methylpropional, citronellol, hexylcinnamal, limoneen, linalool."},{"title":"Hoe gebruik je onze Full moon?","content":"Voeg de full moon wasparfum toe aan je gebruikelijke wasmiddel; het is bedoeld als aanvulling.\r\nDoe een paar druppels wasparfum in het specifieke vakje voor wasverzachter in je wasmachine.\r\nDe wasparfum geeft een heerlijke geur af aan je wasgoed tijdens de laatste spoeling. Gebruik maximaal 2.5ml - vijf milliliter per volle trommel."}],"page_builder":false,"flexible_content":{"page_builder":false},"price_suffix":"Slechts 0,40 cent per wasbeurt","short_description":"","bottom_check_title":"Wij beloven je","bottom_check":[{"item":"Gratis verzending in NL & BE \ud83d\udce6"},{"item":"Uitzonderlijke kwaliteit wasgeur"},{"item":"Op werkdagen voor 16.00 besteld, vandaag verzonden \ud83d\ude80"},{"item":"Gemaakt van milieuvriendelijke \u2028en duurzame materialen"}],"ingredients_title":